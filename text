public class _4_Ebook_request {
    public static void main(String[] args) {
        Ebook e1 = new EbookProxy("Space.pdf");
        e1.open();
    }
}
interface Ebook{
    void open();
}
class RealBook implements Ebook{
    public String filename;

    public RealBook(String filename) {
        this.filename=filename;
        loadFromNet();
    }
    private void loadFromNet(){
        System.out.println(filename+" loaded from internet.");
    }
    public void open(){
        System.out.println("Opening "+filename);
    }
}
class EbookProxy implements Ebook{
    private RealBook realBook;
    public String filename;

    public EbookProxy(String filename) {
        this.filename=filename;
    }
    public void open(){
        if(realBook==null){
            realBook=new RealBook(filename);
        }
        realBook.open();
    }
}
